{
  "name": "provider-guard-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @provider-guard/studio build && pnpm --filter provider-guard build && tsx scripts/copy-studio.ts",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "replay": "tsx scripts/build-replay.ts",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.18.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
