{
  "name": "@provider-guard/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:replay": "vite build --mode replay --outDir dist-replay",
    "preview:replay": "vite preview --outDir dist-replay --port 4748 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "vite build --mode replay --outDir dist-replay && playwright test"
  },
  "dependencies": {
    "geist": "1.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
