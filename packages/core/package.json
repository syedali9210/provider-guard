{
  "name": "provider-guard",
  "version": "0.1.0",
  "description": "The gateway catches errors. provider-guard catches successes that aren't.",
  "license": "MIT",
  "author": "Syed Ali",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syedali9210/vercel-demo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/syedali9210/vercel-demo#readme",
  "bugs": {
    "url": "https://github.com/syedali9210/vercel-demo/issues"
  },
  "type": "module",
  "keywords": [
    "ai",
    "ai-sdk",
    "ai-gateway",
    "middleware",
    "vercel",
    "llm",
    "fallback"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "provider-guard": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node -e \"const fs=require('node:fs');fs.copyFileSync('../../README.md','README.md');fs.copyFileSync('../../LICENSE','LICENSE')\"",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "ai": ">=7 <8"
  },
  "devDependencies": {
    "@ai-sdk/gateway": "4.0.96",
    "@ai-sdk/provider": "4.0.18",
    "@vitest/coverage-v8": "5.0.2",
    "ai": "7.0.118",
    "tsup": "8.5.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
